 "css": "        .salary-table {\n            width: 100%;\n            border-collapse: collapse;\n            margin-bottom: 10px;\n        }\n        \n        .salary-table td {\n            padding: 8px 12px;\n            border-bottom: 1px solid #ddd;\n            vertical-align: middle;\n        }\n        \n        .salary-table td:first-child {\n            width: 30px;\n            text-align: center;\n            font-weight: bold;\n        }\n        \n        .salary-table td:last-child {\n            text-align: right;\n            font-weight: bold;\n            width: 120px;\n        }\n        \n        .section-header {\n            background-color: #f8f9fa;\n            padding: 10px;\n            font-weight: bold;\n            text-align: center;\n            border: 1px solid #333;\n            border-bottom: none;\n        }\n        \n        .earnings-deductions-container {\n            border: 1px solid #333;\n        }\n        \n        .info-label {\n            font-weight: bold;\n            font-size: 11px;\n            margin-bottom: 2px;\n        }\n        \n        .info-value {\n            padding-bottom: 2px;\n            min-height: 18px;\n            margin-bottom: 10px;\n        }\n        \n        .title {\n            font-size: 24px;\n            font-weight: 500;\n            margin-bottom: 10px;\n            \n        }\n        \n        .document-numbers {\n            font-size: 13px;\n            line-height: 1.6;\n            color:#777;\n        }\n        \n        .summary-box {\n            border: 1px solid #333;\n            padding: 10px;\n            text-align: center;\n            margin-top: 20px;\n        }\n        \n        .summary-label {\n            font-weight: bold;\n            font-size: 12px;\n            margin-bottom: 5px;\n        }\n        \n        .summary-amount {\n            font-size: 14px;\n            font-weight: bold;\n        }",
 "custom_format": 1,
 "default_print_language": "es",
 "disabled": 0,
 "doc_type": "Salary Slip",
 "docstatus": 0,
 "doctype": "Print Format",
 "font": "Default",
 "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <title>Salary Slip</title>\n</head>\n<body>\n    <div class=\"container-fluid\">\n        <!-- Header Section -->\n        <div class=\"row\">\n            <div class=\"col-xs-6\">\n                {% if doc.company == \"PROCESOS LAB\" %}\n                <img \n                    src=\"/files/logo-procesolab.jpeg\"\n                    style=\"width: 130px; margin-top: 0; margin-bottom: 30px;\"\n                />\n                {% elif doc.company == \"MOVILAB\" %}\n                <img\n                    src=\"/files/Logo_Movilab_no_BG.png\"\n                    style=\"width: 310px; margin-top: 0; margin-bottom: 30px;\"\n                />\n                {% elif doc.company == \"LABORATORIO CLINICO BETALAB\" %}\n                <img\n                    src=\"/files/Logo_Betalab.png\"\n                    style=\"width: 232px; margin-top: 0px; margin-bottom: 30px;\"\n                />\n                {% endif %}\n            </div>\n            <div class=\"col-xs-6 text-right\">\n                <div class=\"title\">SALARY SLIP</div>\n                <div class=\"document-numbers\">\n                    {{ doc.payroll_entry}}<br>\n                    {{ doc.employee }}<br>\n                    {{ doc.name }}\n                </div>\n            </div>\n        </div>\n        \n        <hr style=\"margin-bottom: 20px;\">\n        \n        <!-- Employee Information Section -->\n        <div class=\"row\">\n            <div class=\"col-xs-4\">\n                <div class=\"info-group\">\n                    <div class=\"info-label\">Empleado:</div>\n                    <div class=\"info-value\">{{ doc.employee }}</div>\n                </div>\n                <div class=\"info-group\">\n                    <div class=\"info-label\">Nombre del empleado:</div>\n                    <div class=\"info-value\">{{ doc.employee_name }}</div>\n                </div>\n                <div class=\"info-group\">\n                    <div class=\"info-label\">M\u00e9todo de pago:</div>\n                    <div class=\"info-value\">{{ doc.mode_of_payment or \"\" }}</div>\n                </div>\n            </div>\n            <div class=\"col-xs-4\">\n                <div class=\"info-group\">\n                    <div class=\"info-label\">Estado:</div>\n                    <div class=\"info-value\">{{ doc.docstatus == 1 and \"Validado\" or \"Borrador\" }}</div>\n                </div>\n                <div class=\"info-group\">\n                    <div class=\"info-label\">Puesto:</div>\n                    <div class=\"info-value\">{{ doc.designation or \"\" }}</div>\n                </div>\n                <div class=\"info-group\">\n                    <div class=\"info-label\">Departamento:</div>\n                    <div class=\"info-value\">{{ doc.department or \"\"}}</div>\n                </div>\n            </div>\n            <div class=\"col-xs-4\">\n                <div class=\"info-group\">\n                    <div class=\"info-label\">Fecha de inicio:</div>\n                    <div class=\"info-value\">{{ frappe.format_value(doc.start_date, {\"fieldtype\":\"Date\"}) or \"\"}}</div>\n                </div>\n                <div class=\"info-group\">\n                    <div class=\"info-label\">Fecha Final:</div>\n                    <div class=\"info-value\">{{ frappe.format_value(doc.end_date, {\"fieldtype\":\"Date\"}) or \"\"}}</div>\n                </div>\n                <div class=\"info-group\">\n                    <div class=\"info-label\">Fecha de Contabilizaci\u00f3n:</div>\n                    <div class=\"info-value\">{{ frappe.format_value(doc.posting_date, {\"fieldtype\":\"Date\"}) or \"\"}}</div></div>\n                </div>\n            </div>\n        </div>\n        \n        <!-- Salary Details Section -->\n        <div class=\"row\" style=\"margin-top: 30px;\">\n            <div class=\"col-xs-6\">\n                <table class=\"table bordered\">\n                    <thead>\n                        <tr>\n                            <th>&nbsp;</th>\n                            <th>&nbsp;</th>\n                            <th>&nbsp;</th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                    {%for item in doc.earnings%}\n                        <tr>\n                            <td>\n                                {{item.idx}}\n                            </td>\n                            <td>\n                                {{frappe.format_value(item.salary_component)}}\n                            </td>\n                            <td>\n                                {{frappe.format_value(item.default_amount,{\"fieldtype\":\"Currency\"} )}}\n                            </td>\n                        </tr>\n    \n                    {%endfor%}\n                    </tbody>\n                </table>\n            </div>\n            <div class=\"col-xs-6\">\n                <table class=\"table bordered\">\n                    <thead>\n                        <tr>\n                            <th styel=\"widht:10%\">&nbsp;</th>\n                            <th styel=\"widht:60%\">&nbsp;</th>\n                            <th styel=\"widht:30%\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                    {%for item in doc.deductions%}\n                        <tr>\n                            <td styel=\"widht:10%\">\n                                {{item.idx}}\n                            </td>\n                            <td styel=\"widht:50%\">\n                                {{frappe.format_value(item.salary_component)}}\n                               \n                            </td>\n                            <td styel=\"widht:30%\">\n                                {{frappe.format_value(item.default_amount,{\"fieldtype\":\"Currency\"} )}}\n                            </td>\n                        </tr>\n    \n                    {%endfor%}\n                    </tbody>\n                </table>\n            </div>\n        <!-- Summary Section -->\n    </div>\n    <div class=\"row\">\n        <div class=\"col-xs-6\">\n            <div class=\"row\">\n                <div class=\"col-xs-6 text-left\">\n                    <span>\n                        <strong>Pago Bruto</strong>\n                    </span>\n                </div>\n                <div class=\"col-xs-6 text-right\">\n                    <span>\n                        {{frappe.format_value(doc.gross_pay,{\"fieldtype\":\"Currency\"} )}}\n                    </span>\n                </div>\n            </div>\n            <div class=\"row\">\n                <div class=\"col-xs-6 text-left\">\n                    <span>\n                        <strong>Pago Neto</strong>\n                    </span>\n                </div>\n                <div class=\"col-xs-6 text-right\">\n                    <span>\n                        {{frappe.format_value( (doc.gross_pay - doc.total_deduction),{\"fieldtype\":\"Currency\"} )}}\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"col-xs-6\">\n            <div class=\"row\">\n                <div class=\"col-xs-6 text-left\">\n                    <span>\n                        <strong>Deduccion Total</strong>\n                    </span>\n                </div>\n                <div class=\"col-xs-6 text-right\">\n                    <span>\n                        {{frappe.format_value(doc.total_deduction,{\"fieldtype\":\"Currency\"} )}}\n                    </span>\n                </div>\n            </div>\n            <div class=\"row\">\n                <div class=\"col-xs-6 text-left\">\n                    <span>\n                        <strong>Total Redondeado</strong>\n                    </span>\n                </div>\n                <div class=\"col-xs-6 text-right\">\n                    <span>\n                        {{frappe.format_value( (doc.gross_pay - doc.total_deduction) | round(0,\"ceil\"),{\"fieldtype\":\"Currency\"} ) }}\n                    </span>\n                </div>\n            </div>\n        </div>\n    </div>\n</html>",
