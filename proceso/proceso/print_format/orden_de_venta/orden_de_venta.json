 "doctype": "Print Format",
 "font": "Default",
 "html": "<div id=\"header-html\" class=\"hidden-pdf\">\n\n    <div class=\"print-heading\">\t\t\t\t\n        <div>\n            {% if doc.company == \"PROCESOS LAB\" %}\n            <img \n                src=\"/files/logo-procesolab.jpeg\"\n                style=\"\n                    float: left; \n                    width: 130px;\n                    margin-top: -26px !important;\n                    margin-bottom: 30px !important;\n                \"\n            />\n            {% elif doc.company == \"MOVILAB\" %}\n            <img\n                src=\"/files/Logo_Movilab_no_BG.png\"\n                style=\"\n                    float: left;\n                    width: 310px;\n                    margin-top: -26px !important;\n                    margin-bottom:30px !important;\n                \"\n            />\n            {% elif doc.company == \"LABORATORIO CLINICO BETALAB\" %}\n            <img\n                src=\"/files/Logo_Betalab.png\"\n                style=\"\n                    float: left;\n                    width: 222px;\n                    margin-top: -17px !important;\n                    margin-bottom:30px !important;\n                \"\n            />\n            {% else %}\n                <span>Logo</span>\n            {% endif %}\n        </div>\n        <h3>\n            {{_(\"Sales Order\")}}\n        </h3>\n            <small>{{ doc.name }}</small><br>\n            <small>Fecha: {{doc.get_formatted(\"transaction_date\")}}</small><br>\n            <small>RNC: 131-46937-1</small>\n        \n    </div>\n    \n</div>\n{% if doc.status == \"Draft\" %}\n<div class=\"text-center\" document-status=\"draft\">\n    <h4 style=\"margin: 0px;\">{{_(\"Draft\")}}</h4>\n</div>\n{% endif %}\n\n\n<div class=\"row section-break\">\n    <div class=\"col-xs-12 column-break\">\n        <div class=\"col-xs-6 column-break\">\n          <div class=\"div-striped\" style=\"font-size: 11px;\">\n            {% set company = frappe.get_doc(\"Company\", doc.company) %}\n            {% if doc.sales_team | length > 0 %}\n                {% set sales_person = frappe.get_doc(\"Sales Person\", doc.sales_team[0].sales_person) %}\n            {% endif %}\n            <div><b>{{_(\"Customer\")}}: </b>{{doc.customer_name}}<br></div>\n            <div><b>RNC/C\u00e9dula:</b> {{doc.tax_id}}<br></div>\n            <div><b>Telefono:</b><br></div>\n            <div><b>Direcci\u00f3n:</b> {{doc.address_display or \"-\"}} <br></div>\n          </div>\n        </div>\n        <div class=\"col-xs-6 column-break\">\n          <div class=\"div-striped\" style=\"font-size: 11px;\">\n            {% set customer = frappe.get_doc(\"Customer\", doc.customer) %}\n            <div><b>Fecha:</b> {{doc.get_formatted(\"transaction_date\")}} <br> </div>\n            <div><b>Vendedor: </b>{{frappe.db.get_value(\"User\", doc.owner, \"full_name\")}}</div>\n            <div>\n                {% set patient_date_of_birth = frappe.db.get_value(\"Patient\", doc.patient, \"dob\") or \"\"%}\n                <b>Fecha de Nacimiento:</b><span>{{frappe.format_value(patient_date_of_birth, {\"fieldtype\":\"Date\"})}}</span>\n            </div>\n            {% if doc.tipo_de_entrega %}\n            <div><b>Tipo Entrega:</b> {{doc.tipo_de_entrega or \"-\"}}<br></div>\n            {% endif %}\n            {% set sufix = \"AM\"%}\n            {% if doc.delivery_time %}\n            <div><b>Entrega:</b> {{ frappe.format_date(doc.delivery_date)}} @ {{doc.delivery_time}}  <br></div>\n            {% endif %}\n            {% if doc.contact_person %}\n              {% set contact = frappe.db.get_value(\"Contact\", doc.contact_person, [\"first_name\", \"last_name\", \"mobile_no\", \"email_id\"], as_dict=True) %}\n            <div>{{_(\"Contact\")}}: {{contact.first_name or \"\"}} {{contact.last_name or \"\"}}</div>\n            <div> Email: {{contact.email_id or \"\"}}</div>\n            <div>{{_(\"Phone\")}}: {{contact.mobile_no or \"\"}}</div>\n            {% endif %}\n          </div>\n        </div>\n    </div>\n</div>\n\n<hr />\n<div class=\"row section-break\">\n    <div class=\"col-xs-12 column-break\">\n        <div data-fieldname=\"items\" data-fieldtype=\"Table\">\n            <table class=\"table table-condensed\">\n                <thead>\n                    <tr>\n                        <th style=\"width: 350px;\" class=\"\" data-fieldname=\"items\" data-fieldtype=\"Table\">\n                            {{_(\"Description\")}} </th>\n                        <th style=\"width: 30px;\" class=\"text-right\" data-fieldname=\"items\" data-fieldtype=\"Table\">\n                            {{_(\"Cant.\")}} </th>\n                        <th style=\"width: 80px;\" class=\"text-right\" data-fieldname=\"items\" data-fieldtype=\"Table\">\n                            {{_(\"Reclamado\")}} </th>\n                        <th style=\"width: 100px;\" class=\"text-right\" data-fieldname=\"items\" data-fieldtype=\"Table\">{{_(\"Autorizado\")}} </th>\n                        <th style=\"width: 100px;\" class=\"text-right\" data-fieldname=\"items\" data-fieldtype=\"Table\">{{_(\"Discount\")}}</th>\n                        <th style=\"width: 100px;\" class=\"text-right\" data-fieldname=\"items\" data-fieldtype=\"Table\">{{_(\"Diferencia\")}}</th>\n                    </tr>\n                </thead>\n                <tbody>\n\n                    {% for item in doc.items %}\n                    <tr>\n                        <td class=\"\" data-fieldname=\"items\" data-fieldtype=\"Table\">\n                            <div class=\"value\">\n                                {{item.item_name}}\n                                {%if item.serial_no %}<br> <small><b>{{ item.serial_no }}</b></small> {%endif%}\n                            </div>\n                        </td>\n\n\n\n                        <td class=\"text-right\" data-fieldname=\"items\" data-fieldtype=\"Table\">\n                            <div class=\"value\">\n                                {{item.qty}}\n                            </div>\n                        </td>\n\n\n\n                        <td class=\"text-right\" data-fieldname=\"items\" data-fieldtype=\"Table\">\n                            <div class=\"value\">\n                                {{frappe.format_value(item.price_list_rate or item.rate, {\"fieldtype\":\"Currency\"})}}\n                            </div>\n                        </td>\n\n                        <td class=\"text-right\" data-fieldname=\"items\" data-fieldtype=\"Table\">\n                            <div class=\"value\">\n                                {{frappe.format_value(item.authorized_amount, {\"fieldtype\":\"Currency\"})}}\n                            </div>\n                        </td>\n\n\n\n                        <td class=\"text-right\" data-fieldname=\"items\" data-fieldtype=\"Table\">\n                            <div class=\"value\">\n                                {{frappe.format_value(item.discount, {\"fieldtype\":\"Currency\"})}}\n                            </div>\n                        </td>\n\n                        <td class=\"text-right\" data-fieldname=\"items\" data-fieldtype=\"Table\">\n                            <div class=\"value\">\n                                {{frappe.format_value(item.difference_amount - item.discount, {\"fieldtype\":\"Currency\"})}}\n                            </div>\n                        </td>\n\n\n                    </tr>\n                    {% endfor %}\n                </tbody>\n                <tfoot class=\"total-row text-right\">\n                    <tr>\n\n                        <th colspan=\"2\" class=\"text-right\">Subtotal:</th>\n                        <td colspan=4 style=\"font-size:13px;\">{{doc.get_formatted(\"total\")}}</td>\n                    </tr>\n                    <tr>\n                        <th colspan=\"2\" class=\"text-right\">Descuentos:</th>\n                        <td colspan=4 style=\"font-size:13px;\">{{ frappe.format_value(doc.items | sum(attribute=\"discount\"), {\"fieldtype\":\"Currency\"}) }}</td>\n                    </tr>\n                    <!--                     <tr>\n                        <th></th>\n                        <th>Descuento:</th>\n                        <td colspan=4 style=\"font-size:13px;\">{{doc.get_formatted(\"discount_amount\")}}</td>\n                    </tr> -->\n                    <tr>\n                        <th colspan=\"2\" class=\"text-right\">Dif. Paciente:</th>\n                        <td colspan=4 style=\"font-size:13px;\">{{ frappe.format_value(doc.grand_total, {\"fieldtype\":\"Currency\"}) }}</td>\n                    </tr>\n                </tfoot>\n            </table>\n        </div>\n    </div>\n</div>\n    <div class=\"row section-break\">\n    <div class=\"col-md-6 column-break\">\n    </div>\n    <div class=\"col-md-6 column-break\">\n        <div style=\"text-align: right;\">\n            <!--<span class=\"vb-text\">{{_(doc.in_words).upper().replace(\"DOP\", \"\").replace(\"SOLO\", \"\")}}</span>-->\n        </div>\n    </div>\n</div>\n\n{% if doc.remarks and doc.remarks != \"No Remarks\" %}\n<div class=\"row section-break\">\n    <div class=\"col-xs-12 column-break head-details\" style=\"height: 70px;\">\n        <div class=\"row data-field\" style=\"margin-left: 0px;margin-right: 0px;\" data-fieldname=\"remarks\" data-fieldtype=\"Float\">\n            <div><b> Notas: </b> {{(doc.remarks)}} <br></div>\n        </div>\n    </div>\n</div>\n{%endif%}\n\n<div class=\"row section-break\">\n    <div class=\"col-md-12\">\n        <br>\n        <table>\n            <tr>\n                <td style=\"border: none !important;\">\n                    <span>Entregado por: </span>\n                </td>\n                <td style=\"border: none !important;\">\n                    <u>&nbsp;&nbsp;&nbsp;&nbsp;{{frappe.db.get_value(\"User\", doc.owner, \"full_name\")}} &nbsp;&nbsp;&nbsp;&nbsp;</u>\n                </td>\n                <td style=\"border: none !important;\">\n                    <span>Recibido por: </span>\n                </td>\n                <td style=\"border: none !important;\">\n                    _______________________\n                </td>\n            <tr>\n        </table>\n        <br>\n        <strong>\u00a1Gracias por preferirnos!</strong>\n        <br>\n        <span>Favor verificar que su pedido esta bien hecho y completo, luego no podremos aceptar devoluciones.</span>\n    </div>\n</div>\n<div id=\"footer-html\" style=\"width:100%; margin-left: 0px;\">\n    <div class=\"row section-break\">\n        <div class=\"col-xs-4 column-break\">\n            <div style=\"font-size: 9px;\">\n                {% set address_name = frappe.db.get_value(\"Dynamic Link\", {\"parentfield\": \"links\", \"parenttype\": \"Address\", \"link_doctype\": \"Company\", \"link_name\": doc.company}, \"parent\") %}\n              \n                {%set address_html = frappe.db.get_value(\"Address\", address_name, [\"address_line1\", \"city\", \"county\", \"country\",\"pincode\", \"phone\"], as_dict=True)%}\n                <div><b>Oficina Principal:</b><br></div>\n                <div>{{address_html.address_line1}}, {{address_html.county}}, {{address_html.pincode}}</div>\n                <div>{{address_html.city}}</div>\n                <div><b>Tel\u00e9fono: {{address_html.phone}}</b></div>\n            </div>\n        </div>\n        <div class=\"col-xs-4 column-break\">\n            <div style=\"font-size: 9px;\">\n                <div><b>Santiago:</b><br></div>\n                <div>Av. 27 de Febrero esq. Estrella Sadhal\u00e1, Plaza Las Galer\u00edas 1er Nivel<br></div>\n                <div><b>Tel: 809-581-9256</b><br></div>\n            </div>\n        </div>\n    </div>\n    <p class=\"text-center small page-number visible-pdf\">\n        <b>Derechos Reservados</b>\n    </p>\n</div>\n\n",
