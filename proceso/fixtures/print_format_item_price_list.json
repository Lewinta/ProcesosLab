{
 "doctype": "Print Format",
 "name": "Item Price List Print Format",
 "doc_type": "",
 "print_format_type": "Jinja",
 "html": "<style>\n    .report-container {\n        font-family: Arial, sans-serif;\n        max-width: 100%;\n        margin: 0 auto;\n        padding: 20px;\n    }\n    .header {\n        text-align: center;\n        margin-bottom: 30px;\n        border-bottom: 2px solid #007bff;\n        padding-bottom: 20px;\n    }\n    .logo {\n        width: 130px;\n        margin-bottom: 15px;\n    }\n    .report-title {\n        font-size: 24px;\n        font-weight: bold;\n        color: #333;\n        margin: 10px 0;\n    }\n    .report-subtitle {\n        font-size: 14px;\n        color: #666;\n    }\n    .filters-section {\n        background-color: #f8f9fa;\n        border: 1px solid #dee2e6;\n        border-radius: 5px;\n        padding: 15px;\n        margin-bottom: 25px;\n    }\n    .data-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 30px;\n    }\n    .data-table th {\n        background-color: #343a40;\n        color: white;\n        padding: 12px 8px;\n        text-align: left;\n        border: 1px solid #454d55;\n    }\n    .data-table td {\n        padding: 10px 8px;\n        border: 1px solid #dee2e6;\n    }\n    .data-table tr:nth-child(even) {\n        background-color: #f8f9fa;\n    }\n    .item-code {\n        font-family: monospace;\n        font-weight: bold;\n    }\n    .price {\n        text-align: right;\n        font-weight: bold;\n        color: #28a745;\n    }\n</style>\n\n<div class=\"report-container\">\n    <div class=\"header\">\n        <img src=\"/files/logo-procesolab.jpeg\" alt=\"Logo\" class=\"logo\">\n        <div class=\"report-title\">Lista de Precios de Artículos</div>\n        <div class=\"report-subtitle\">Generado el {{ frappe.format_datetime(frappe.utils.now()) }}</div>\n    </div>\n    \n    {% if filters %}\n    <div class=\"filters-section\">\n        <strong>Filtros aplicados:</strong><br>\n        {% if filters.get('price_list') %}\n            Lista de Precios: {{ filters.get('price_list') }}<br>\n        {% endif %}\n        {% if filters.get('item_code') %}\n            Código de Artículo: {{ filters.get('item_code') }}<br>\n        {% endif %}\n    </div>\n    {% endif %}\n    \n    <table class=\"data-table\">\n        <thead>\n            <tr>\n                <th>Código de Artículo</th>\n                <th>Nombre del Artículo</th>\n                <th>Lista de Precios</th>\n                <th>Precio</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in data %}\n            <tr>\n                <td><span class=\"item-code\">{{ row.item_code }}</span></td>\n                <td>{{ row.item_name }}</td>\n                <td>{{ row.price_list }}</td>\n                <td class=\"price\">{{ frappe.format_value(row.price_list_rate, {\"fieldtype\": \"Currency\"}) }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n    \n    <div style=\"margin-top: 20px; font-size: 12px; color: #666;\">\n        <strong>Total de registros:</strong> {{ data|length }}<br>\n        <strong>Generado por:</strong> Proceso Lab - {{ frappe.format_datetime(frappe.utils.now()) }}\n    </div>\n</div>",
 "standard": "Yes",
 "module": "Proceso",
 "custom_format": 1,
 "default_print_language": "es"
}
